# ============================================================
# @vehiclefinance/bot — environment variables
# Copy to .env and fill in the values before running.
# NEVER commit .env to version control.
# ============================================================

# ----------------------------------------------------------
# Server
# ----------------------------------------------------------
PORT=3001
NODE_ENV=development

# ----------------------------------------------------------
# Anthropic (Claude Agent SDK)
# ----------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# ----------------------------------------------------------
# Dialog360 WhatsApp Business API
# ----------------------------------------------------------
# API key from the Dialog360 partner portal
DIALOG360_API_KEY=your_dialog360_api_key_here

# Base URL of your Dialog360 WABA channel
# Production example: https://waba.360dialog.io/v1
# Sandbox example:    https://waba-sandbox.360dialog.io/v1
DIALOG360_API_URL=https://waba.360dialog.io/v1

# Channel ID from Dialog360 partner portal
DIALOG360_CHANNEL_ID=your-channel-id

# Webhook verification token (set in Dialog360 channel settings)
DIALOG360_WEBHOOK_VERIFY_TOKEN=your-random-verify-token

# ----------------------------------------------------------
# BulkSMS — SMS fallback
# ----------------------------------------------------------
# Token ID from https://www.bulksms.com/account/token-ids.php
BULKSMS_TOKEN_ID=your_bulksms_token_id_here

# Token secret associated with the token ID above
BULKSMS_TOKEN_SECRET=your_bulksms_token_secret_here

# ----------------------------------------------------------
# SendGrid — email notifications
# ----------------------------------------------------------
# API key (starts with SG.)
# Create at https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# Verified sender address (must be verified in SendGrid)
SENDGRID_FROM_EMAIL=noreply@vehiclefinance.co.za

# Sender display name
SENDGRID_FROM_NAME=Vehicle Finance

# Optional: SendGrid dynamic template IDs
# If unset, the bot falls back to inline HTML emails
SENDGRID_QUOTE_TEMPLATE_ID=d-your_quote_template_id
SENDGRID_CONTRACT_TEMPLATE_ID=d-your_contract_template_id
SENDGRID_WELCOME_TEMPLATE_ID=d-your_welcome_template_id

# ----------------------------------------------------------
# Supabase
# ----------------------------------------------------------
# Project URL — find in Supabase dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co

# Service-role key — bypasses RLS (keep this SECRET)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ----------------------------------------------------------
# Document extraction service (placeholder)
# ----------------------------------------------------------
# URL of the extraction microservice / edge function
EXTRACTION_SERVICE_URL=https://your-project-ref.supabase.co/functions/v1/extract-document

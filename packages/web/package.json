{
  "name": "@vehiclefinance/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "React internal portal for loan officers and ops team",
  "scripts": {
    "dev": "NODE_OPTIONS=--max-http-header-size=32768 vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:prod": "E2E_BASE_URL=https://orange-bay-0066a4b03.7.azurestaticapps.net playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report e2e/.report"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "@vehiclefinance/shared": "workspace:*",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.8.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^14.2.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "1.6.1",
    "autoprefixer": "^10.4.17",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.11",
    "vitest": "^1.3.0"
  }
}

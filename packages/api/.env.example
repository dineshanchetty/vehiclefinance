# ============================================================
# @vehiclefinance/api — environment variables
# Copy to .env and fill in the values before running.
# ============================================================

# Supabase project ref (from dashboard URL).
# Use STAGING / UAT — never the prod ref. uat-reset.sh blocks known prod refs.
SUPABASE_PROJECT_ID=your-staging-project-ref

# Personal access token for the Supabase CLI (https://supabase.com/dashboard/account/tokens).
# Used by `supabase link`, `db push`, `gen types`, and CI deploys.
SUPABASE_ACCESS_TOKEN=sbp_...

# ----------------------------------------------------------
# Deno integration tests
# ----------------------------------------------------------
# URL and service-role key for the DB the integration tests target.
# For local dev: point at a staging branch. Never run against prod.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

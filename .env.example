# ═══════════════════════════════════════════════════════════════════════════
# Vehicle Finance — root .env.example
#
# Each package owns its own .env file. This file is a pointer so a new
# engineer knows where each secret lives.
#
#   packages/bot/.env    — Dialog360, BulkSMS, SendGrid, Anthropic, Supabase
#                          service-role key
#   packages/web/.env    — Supabase URL + anon key (frontend-safe)
#   packages/api/.env    — Supabase CLI auth for migrations + types gen
#
# Copy each package's .env.example to .env and fill in. Never commit .env.
# ═══════════════════════════════════════════════════════════════════════════

# ----------------------------------------------------------
# Repo-wide (used by root scripts like `pnpm gen:types`)
# ----------------------------------------------------------
# Supabase project ref (from dashboard URL). Used by root gen:types script.
# Use your STAGING or UAT project ref — NEVER the prod ref. The UAT reset
# script (packages/api/scripts/uat-reset.sh) refuses to run against known
# prod refs, but secrets leakage is easy to cause without that guard.
SUPABASE_PROJECT_ID=your-staging-project-ref

# Personal access token for the Supabase CLI (https://supabase.com/dashboard/account/tokens).
# Required for `supabase gen types typescript --project-id ...` and for CI deploys.
SUPABASE_ACCESS_TOKEN=sbp_...
